# Copy to .env for local development. On Vercel, add these in
# Project > Settings > Environment Variables.

# Your custom domain, with https:// and no trailing slash
NEXT_PUBLIC_SITE_URL="https://brokebuddies.my.id"
# Shown on the Privacy Policy, Terms and footer
NEXT_PUBLIC_CONTACT_EMAIL="hello@brokebuddies.my.id"
# Your name or your project's name, shown as the operator in the legal pages
NEXT_PUBLIC_OPERATOR_NAME="BrokeBuddies"

# Prisma Postgres (console.prisma.io): the direct postgres:// connection string
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Auth.js: generate with
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Optional: Google sign-in. Leave both empty to turn it off.
# (console.cloud.google.com > Google Auth Platform > Clients)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only needed locally (Vercel sets this automatically)
AUTH_TRUST_HOST=true

# Vercel Blob: added automatically when you connect a Blob store to the project
BLOB_READ_WRITE_TOKEN=""